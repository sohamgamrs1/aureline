{
  "name": "aureline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "fetch:models": "node scripts/fetch-mediapipe.mjs",
    "test": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=.selftest.mjs --log-level=warning && node .selftest.mjs",
    "apk:add": "npx cap add android",
    "apk:sync": "npm run build && npx cap sync android",
    "apk:open": "npx cap open android",
    "apk:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/core": "6.1.2",
    "@mediapipe/tasks-vision": "0.10.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@capacitor/cli": "6.1.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "esbuild": "0.25.0",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3",
    "vite": "5.4.2"
  }
}
